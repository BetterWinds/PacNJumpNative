#include <winver.h>
VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PNJ_RC_VER@
 PRODUCTVERSION @PNJ_RC_VER@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Pac'N-Jump native port"
      VALUE "FileVersion", "@PNJ_VERSION@"
      VALUE "InternalName", "pacnjump"
      VALUE "LegalCopyright", "MIT License"
      VALUE "OriginalFilename", "pacnjump.exe"
      VALUE "ProductName", "Pac'N-Jump native"
      VALUE "ProductVersion", "@PNJ_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
